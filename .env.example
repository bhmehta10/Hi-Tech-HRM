# Copy to .env and fill in.
DATABASE_URL="postgresql://hrm:change-me@localhost:5432/hrm"
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=""
# Set to true once the site is served over HTTPS
COOKIE_SECURE="false"
# First admin login, used by `npm run db:seed`
ADMIN_CODE="ADMIN"
ADMIN_NAME="HR Admin"
ADMIN_PASSWORD=""
# Accept any device that connects (use only while installing devices)
DEVICE_AUTO_REGISTER="false"
POSTGRES_PASSWORD="change-me"
